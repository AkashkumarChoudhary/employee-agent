# Copy to .env and fill in. .env is gitignored.
# docker compose reads this file automatically.

# --- LLM provider -----------------------------------------------------------
# provider: gemini (real demo) | fake (offline, empty output) | ollama (local)
PROVIDER=gemini
GEMINI_API_KEY=your-ai-studio-key-here
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# Failover falls back to a local Ollama daemon when Gemini errors.
# Leave false unless `ollama serve` is actually running.
ENABLE_FAILOVER=false
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434
TEMPERATURE=0.0

# --- API --------------------------------------------------------------------
# Comma-separated keys accepted in the X-API-Key header. Rotate before any
# non-local deployment; the UI sends EMPLOYEE_AGENT_API_KEY.
API_KEYS=demo-key
RATE_LIMIT=100/minute

# --- State ------------------------------------------------------------------
SQLITE_PATH=./data/employee_agent.db
CHROMA_PATH=./data/chroma
